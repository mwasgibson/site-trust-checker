{
  "manifest_version": 3,
  "name": "Site Trust Checker",
  "version": "0.1.0",
  "description": "Checks the site you're on for security issues and signs of being fake or AI-generated.",
  "permissions": ["activeTab", "storage", "tabs", "scripting"],
  "host_permissions": ["https://site-trust-checker.onrender.com/*","http://localhost:3100/*"],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_popup": "index.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
