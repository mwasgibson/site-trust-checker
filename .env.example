# Copy this file to .env and fill in your keys.
# Get a free Safe Browsing key at:
# https://developers.google.com/safe-browsing/v4/get-started
GOOGLE_SAFE_BROWSING_API_KEY=

# Anthropic API key, used by checks/aiContent.js to rate whether page
# copy reads as AI-generated/templated. Get one at https://console.anthropic.com
ANTHROPIC_API_KEY=

# Optional: override the model used for content analysis (defaults to Haiku, cheapest).
AI_CONTENT_MODEL=claude-haiku-4-5-20251001

# Comma-separated list of userIds that get unlimited token usage.
# Find your own generated ID in the extension popup, then add it here.
ADMIN_USER_IDS=

# Leave blank/unset for unlimited free usage for everyone (current default).
# Set to a number (e.g. 100000) once you're ready to enforce a free-tier cap
# and add a subscription flow — see backend/src/services/usageTracker.js.
FREE_TOKEN_LIMIT=

PORT=3100
