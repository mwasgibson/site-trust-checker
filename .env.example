# Copy this file to .env and fill in your keys.

# Google Safe Browsing (optional but recommended)
# Get a free key at: https://developers.google.com/safe-browsing/v4/get-started
GOOGLE_SAFE_BROWSING_API_KEY=

# OpenRouter API key — used by checks/aiContent.js for AI/template content scoring.
# Get one at https://openrouter.ai/keys
OPENROUTER_API_KEY=

# OpenRouter model id (author/slug). Defaults to openrouter/free (zero cost when available).
# Examples:
#   openrouter/free
#   anthropic/claude-haiku-4.5
#   google/gemini-2.0-flash-lite-001
#   openai/gpt-4o-mini
AI_CONTENT_MODEL=openrouter/free

# Optional attribution headers OpenRouter uses for rankings (recommended)
OPENROUTER_HTTP_REFERER=https://github.com/mwasgibson/site-trust-checker
OPENROUTER_APP_TITLE=Site Trust Checker

# Comma-separated list of userIds that get unlimited token usage.
# Find your own generated ID in the extension popup, then add it here.
ADMIN_USER_IDS=

# Leave blank/unset for unlimited free usage for everyone (current default).
# Set to a number (e.g. 100000) once you're ready to enforce a free-tier cap
# and add a subscription flow — see backend/src/services/usageTracker.js.
FREE_TOKEN_LIMIT=

PORT=3100
